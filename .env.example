# Copia este archivo a .env en la raiz y completa las tres contrasenas.
# No publiques .env. Usa comillas simples si un valor contiene $ o #.
PRODUCTOS_DB_PASSWORD=
ORDENES_DB_PASSWORD=
ENVIOS_DB_PASSWORD=

# Puertos publicados en 127.0.0.1 por el Compose completo.
FRONTEND_PORT=8088
GATEWAY_PORT=8080

# Solo para Base_de_Datos/docker-compose.yml (desarrollo local).
PRODUCTOS_DB_PORT=15432
ORDENES_DB_PORT=25432
ENVIOS_DB_PORT=35432
